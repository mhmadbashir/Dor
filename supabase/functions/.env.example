# Local secrets for `supabase functions serve` / `supabase start`. Copy to .env.
# Must match the notify_cron_secret Vault secret created in seed.sql.
NOTIFY_CRON_SECRET=local-notify-cron-secret
# Paste the Firebase service account JSON (one line) to send real pushes locally.
# Leave empty for dry-run mode (pushes are logged instead of sent).
FCM_SERVICE_ACCOUNT=
